# Yerel gelistirmede varsayilan "prod" profilini "dev"e cevirir - AuthDebugController
# (@Profile("dev")) SADECE bu satir varken register olur. Gercek bir deploy'da bu
# satiri KOYMA (ya da sil), application.properties'teki prod varsayilani gecerli kalsin.
spring.profiles.active=dev

DB_URL=jdbc:postgresql://localhost:5432/surumnotu
DB_USERNAME=postgres
DB_PASSWORD=degistir_bu_sifreyi

# HS256 icin en az 32 byte (256 bit) rastgele, base64 bir deger kullan
JWT_SECRET=degistir_bu_gizli_anahtari
JWT_EXPIRATION_MS=3600000

# Ilk admin kullanicisi: veritabaninda hic ADMIN yoksa uygulama baslarken otomatik olusturulur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistir_bu_admin_sifresini

# Gmail SMTP (uygulama sifresi kullan, normal Gmail sifresini degil)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# UYARI: true SADECE yerel gelistirme/test icin - GET /api/auth/debug/reset-code
# herkese aktif sifirlama kodunu dondurur. Gercek bir deploy'da false birak.
DEBUG_RESET_CODE_ENABLED=false

